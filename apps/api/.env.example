# Postgres (local dev matches docker-compose.yml below)
DATABASE_URL="postgresql://builderos:builderos@localhost:5432/builderos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Email (Resend)
RESEND_API_KEY=""
# Must be an address on a domain you have VERIFIED in Resend. Until a domain is
# verified, Resend only delivers to the account owner's own address and returns
# a 403 validation_error for everyone else — the code then falls back to the
# server log (see common/mailer.service.ts).
MAIL_FROM="BuilderOS <hello@builderos.dev>"
MAGIC_LINK_FROM_EMAIL="hello@builderos.dev"

# Primary frontend origin. Also used as the SIWE `uri` in auth.service.ts, so
# it must be a single URL, not a list.
APP_BASE_URL="http://localhost:3000"

# CORS allowlist — comma-separated, no trailing slashes. Every browser origin
# that needs to call this API must appear here. In production this is the only
# thing standing between your users' refresh cookies and any other website, so
# list real origins only; never use a wildcard.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Optional. Your Vercel team slug, to allow branch-preview deploys such as
# builderos-git-main-<slug>.vercel.app. Leave empty to block previews.
# Scoped to the slug on purpose: matching all of *.vercel.app would trust every
# project anyone has ever deployed there.
VERCEL_PREVIEW_SUFFIX=""

# Wallet auth
SIWE_DOMAIN="builderos.dev"
SIWE_NONCE_TTL_MINUTES="10"

NODE_ENV="development"
PORT="4000"
