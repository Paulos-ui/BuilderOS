# Postgres (local dev matches docker-compose.yml below)
DATABASE_URL="postgresql://builderos:builderos@localhost:5432/builderos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Email magic-link (Resend)
RESEND_API_KEY=""
MAGIC_LINK_FROM_EMAIL="hello@builderos.dev"
APP_BASE_URL="http://localhost:3000"

# Wallet auth
SIWE_DOMAIN="builderos.dev"
SIWE_NONCE_TTL_MINUTES="10"

NODE_ENV="development"
PORT="4000"
