// BuilderOS Core Platform — Prisma schema
// Mirrors Section 4 of docs/BuilderOS_Blueprint.md
//
// Requires the pgvector extension on the target Postgres instance:
//   CREATE EXTENSION IF NOT EXISTS vector;
// Managed providers: Neon and Supabase both support this out of the box.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum AuthProvider {
  EMAIL
  WALLET
  BOTH
}

enum OpportunityCategory {
  GRANT
  HACKATHON
  BOUNTY
  ACCELERATOR
  ECOSYSTEM_FUND
}

enum OpportunityStatus {
  OPEN
  CLOSED
  STALE
}

enum ApplicationStatus {
  DRAFT
  SCORED
  SUBMITTED
  WON
  REJECTED
}

enum AttestationType {
  GRANT_COMPLETED
  CONTRIBUTION_VERIFIED
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
}

model User {
  id            String        @id @default(uuid())
  email         String?       @unique
  walletAddress String?       @unique @map("wallet_address")
  authProvider  AuthProvider  @default(EMAIL) @map("auth_provider")
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?     @map("deleted_at")

  builderProfile BuilderProfile?
  authNonces     AuthNonce[]

  @@map("users")
}

/// Single-use nonces for SIWE-style wallet signature challenges.
model AuthNonce {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  address   String
  nonce     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([address])
  @@map("auth_nonces")
}

/// Single-use tokens for passwordless email magic-link sign-in.
///
/// UNUSED as of the wallet-first sign-in change: nothing in `src/` reads or
/// writes this model, and email OTP goes through `/v1/auth/email/otp` instead.
///
/// Kept deliberately rather than dropped. Removing it means a destructive
/// migration against the production Neon database, and the only thing that
/// buys is one fewer empty table. Magic-link sign-in also comes back the
/// moment a custom domain lets Resend verify a sending address, which is
/// already on the roadmap — so this would likely be dropped and recreated.
///
/// If it is still unused once email sign-in ships properly, drop it then, in
/// its own migration, with nothing else in the change.
model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("magic_link_tokens")
}

model BuilderProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  githubUsername String?  @map("github_username")
  chains         Json     @default("[]")
  languages      Json     @default("[]")
  bio            String?
  /// pgvector embedding of the profile text, used by BuilderMatch to rank
  /// collaborators and by BuilderScout to rank opportunities.
  /// Unsupported by Prisma Client's query builder, so it is read and written
  /// via $queryRawUnsafe / $executeRawUnsafe. Written by
  /// ProfilesService.refreshEmbedding(); read by MatchService.
  /// NULL means "not enough profile text to embed" and is meaningful — callers
  /// must skip those rows rather than substitute a zero vector, which would
  /// read as maximally similar to everything.
  embedding      Unsupported("vector(1536)")?
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user               User                @relation(fields: [userId], references: [id])
  opportunityMatches OpportunityMatch[]
  applications       Application[]
  attestations       Attestation[]
  payments           Payment[]

  @@map("builder_profiles")
}

model Opportunity {
  id             String              @id @default(uuid())
  sourceUrl      String              @map("source_url")
  sourceName     String              @map("source_name")
  title          String
  description    String
  category       OpportunityCategory
  chains         Json                @default("[]")
  fundingMin     Decimal?            @map("funding_min")
  fundingMax     Decimal?            @map("funding_max")
  deadline       DateTime?
  eligibility    Json                @default("{}")
  lastVerifiedAt DateTime            @map("last_verified_at")
  status         OpportunityStatus   @default(OPEN)
  /// pgvector embedding of the opportunity description, used for hybrid
  /// similarity + structured-filter retrieval (Blueprint Section 6.4).
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime            @default(now()) @map("created_at")

  matches      OpportunityMatch[]
  applications Application[]

  @@index([deadline, status])
  @@map("opportunities")
}

model OpportunityMatch {
  id               String   @id @default(uuid())
  builderProfileId String   @map("builder_profile_id")
  opportunityId    String   @map("opportunity_id")
  score            Decimal
  reason           Json     @default("{}")
  saved            Boolean  @default(false)
  dismissed        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  builderProfile BuilderProfile @relation(fields: [builderProfileId], references: [id])
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id])

  @@unique([builderProfileId, opportunityId])
  @@map("opportunity_matches")
}

model Application {
  id               String            @id @default(uuid())
  builderProfileId String            @map("builder_profile_id")
  opportunityId    String            @map("opportunity_id")
  status           ApplicationStatus @default(DRAFT)
  content          Json              @default("{}")
  score            Decimal?
  scoreBreakdown   Json?             @map("score_breakdown")
  modelVersion     String?           @map("model_version")
  promptVersion    String?           @map("prompt_version")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  builderProfile BuilderProfile @relation(fields: [builderProfileId], references: [id])
  opportunity    Opportunity    @relation(fields: [opportunityId], references: [id])
  attestations   Attestation[]

  @@index([builderProfileId, status])
  @@map("applications")
}

model Attestation {
  id               String          @id @default(uuid())
  builderProfileId String          @map("builder_profile_id")
  applicationId    String?         @map("application_id")
  type             AttestationType
  chainTxHash      String?         @map("chain_tx_hash")
  issuedAt         DateTime        @default(now()) @map("issued_at")
  metadata         Json            @default("{}")

  builderProfile BuilderProfile @relation(fields: [builderProfileId], references: [id])
  application    Application?   @relation(fields: [applicationId], references: [id])

  @@map("attestations")
}

model Payment {
  id                String        @id @default(uuid())
  fromRef           String        @map("from_ref")
  toBuilderProfileId String       @map("to_builder_profile_id")
  amount            Decimal
  currency          String
  x402PaymentId     String?       @map("x402_payment_id")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")

  toBuilderProfile BuilderProfile @relation(fields: [toBuilderProfileId], references: [id])

  @@map("payments")
}

/// Append-only audit/eval log for every agent invocation — see Section 6.5/6.6 of the blueprint.
model AgentRun {
  id         String   @id @default(uuid())
  agentName  String   @map("agent_name")
  userId     String?  @map("user_id")
  input      Json
  output     Json
  latencyMs  Int      @map("latency_ms")
  model      String
  costUsd    Decimal  @map("cost_usd")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([agentName, createdAt])
  @@map("agent_runs")
}

/// Private-beta signups from the marketing site.
model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String?
  ecosystem String?
  goal      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_signups")
}

/// Six-digit email sign-in codes. Stores a salted hash, never the code.
model EmailOtp {
  id        String    @id @default(uuid())
  email     String
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("email_otps")
}


enum ApplicationStage {
  DRAFTING
  REVIEWING
  SUBMITTED
  WON
  REJECTED
  ABANDONED
}

/// BuilderFlow — an application the builder is actively pursuing.
model TrackedApplication {
  id               String           @id @default(uuid())
  builderProfileId String           @map("builder_profile_id")
  opportunityId    String?          @map("opportunity_id")
  title            String
  sourceUrl        String?          @map("source_url")
  stage            ApplicationStage @default(DRAFTING)
  deadline         DateTime?
  notes            String?
  checklist        Json             @default("[]")
  lastScore        Int?             @map("last_score")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([builderProfileId, stage])
  @@index([deadline])
  @@map("tracked_applications")
}

/// BuilderRep — a portable record of completed work.
model ProofRecord {
  id               String   @id @default(uuid())
  builderProfileId String   @map("builder_profile_id")
  applicationId    String?  @map("application_id")
  kind             String
  title            String
  description      String?
  evidenceUrl      String?  @map("evidence_url")
  occurredAt       DateTime @map("occurred_at")
  verified         Boolean  @default(false)
  chainTxHash      String?  @map("chain_tx_hash")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([builderProfileId, occurredAt])
  @@map("proof_records")
}

/// BuilderPay — metered agent usage.
model UsageRecord {
  id               String   @id @default(uuid())
  builderProfileId String   @map("builder_profile_id")
  agentKey         String   @map("agent_key")
  operation        String
  billable         Boolean  @default(true)
  settled          Boolean  @default(false)
  x402OrderId      String?  @map("x402_order_id")
  amountMinor      Int?     @map("amount_minor")
  currency         String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([builderProfileId, createdAt])
  @@index([x402OrderId])
  @@map("usage_records")
}

enum X402OrderStatus {
  /// Challenge issued, no payment presented yet.
  REQUIRED
  /// Signature checked and the authorization is valid.
  VERIFIED
  /// Authorization broadcast on-chain and confirmed.
  SETTLED
  /// Verification or settlement failed. `failureReason` says which.
  FAILED
}

/// BuilderPay (AG-06) — one row per x402 payment challenge and its resolution.
///
/// This table exists for replay protection above everything else. An EIP-3009
/// `transferWithAuthorization` signature is a bearer instrument: whoever holds
/// it can present it, and the contract will honour it once. Without a record of
/// spent nonces, a client could replay one signed authorization against every
/// paid endpoint and be served each time — the transfer would only ever land
/// once on-chain, so nothing would look broken from the payer's side. The
/// unique index on `nonce` is the enforcement point.
///
/// It is also the settlement ledger the console reads, which is why failed
/// attempts are kept rather than deleted: a builder who was charged and not
/// served needs that visible, and so do we.
model X402Order {
  id               String          @id @default(uuid())
  builderProfileId String?         @map("builder_profile_id")
  agentKey         String          @map("agent_key")
  operation        String
  /// Canonical URL of the thing being paid for, as sent in the challenge.
  resource         String
  scheme           String          @default("exact")
  network          String
  /// ERC-20 contract the payment is denominated in.
  asset            String
  payTo            String          @map("pay_to")
  /// Decimal string, not Int. Token amounts are uint256 and an 18-decimal
  /// asset overflows a 32-bit column; more importantly this exact string is
  /// part of the signed payload, so any numeric round-trip risks producing a
  /// value that no longer verifies.
  amountMinor      String          @map("amount_minor")
  currency         String
  payerAddress     String?         @map("payer_address")
  /// The EIP-3009 authorization nonce. Unique — this is the replay guard.
  nonce            String?         @unique
  status           X402OrderStatus @default(REQUIRED)
  settlementTx     String?         @map("settlement_tx")
  failureReason    String?         @map("failure_reason")
  validBefore      DateTime?       @map("valid_before")
  createdAt        DateTime        @default(now()) @map("created_at")
  verifiedAt       DateTime?       @map("verified_at")
  settledAt        DateTime?       @map("settled_at")

  @@index([builderProfileId, createdAt])
  @@index([status, createdAt])
  @@map("x402_orders")
}
