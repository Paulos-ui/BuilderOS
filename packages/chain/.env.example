# ── ERC-8004 agent registration ────────────────────────────────────────────
AGENT_OWNER_PRIVATE_KEY=0x...

# Both of these are written into the public registry, permanently, at
# registration time. Point them at hosts that resolve TODAY — a registration
# naming an unregistered domain still succeeds, so a wrong value here produces a
# dead link nothing in the output will warn you about.
BUILDEROS_API_BASE=https://builderos-api.onrender.com
BUILDEROS_SITE_BASE=https://builderos1.vercel.app

# Set after pinning each phase-1 registration document
AGENT_URI_SCOUT=
AGENT_URI_FORGE=

# ── x402 payments (server-side only — never expose the secret) ─────────────
GOATX402_API_URL=https://api.x402.goat.network
GOATX402_API_KEY=
GOATX402_API_SECRET=
GOATX402_MERCHANT_ID=
